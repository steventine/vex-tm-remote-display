# Windows x86-64 build using MinGW-w64.
#
# Works in two modes — auto-detected by $(OS):
#
#   1. Native build in MSYS2 MinGW64 shell (OS=Windows_NT):
#        pacman -S mingw-w64-x86_64-gcc mingw-w64-x86_64-x264 \
#                  mingw-w64-x86_64-libjpeg-turbo make
#        make -f Makefile.Windows
#        make -f Makefile.Windows debug    # debug build (no strip, -g -O0)
#
#   2. Cross-compile from Linux (OS unset):
#        sudo apt install gcc-mingw-w64-x86-64
#        make CROSS_COMPILE_WINDOWS=1      # called by parent Makefile

# ---------------------------------------------------------------------------
# Toolchain — native MSYS2 vs Linux cross-compile
# ---------------------------------------------------------------------------
ifeq ($(OS),Windows_NT)
    # Running inside an MSYS2 MinGW64 shell
    CC      = gcc
    STRIP   = strip
    WINDRES = windres
    DEFAULT_PREFIX = /mingw64
else
    # Cross-compiling from Linux
    CC      = x86_64-w64-mingw32-gcc
    STRIP   = x86_64-w64-mingw32-strip
    WINDRES = x86_64-w64-mingw32-windres
    DEFAULT_PREFIX = /usr/x86_64-w64-mingw32
endif

CFLAGS  = -Wall -Wextra -O2 -std=c11 -D_WIN32_WINNT=0x0601
LDFLAGS = -static -lws2_32 -lpthread -lwinmm

EXE = tm_stream_server.exe

# ---------------------------------------------------------------------------
# JPEG (for --mode mjpeg)
# ---------------------------------------------------------------------------
TURBOJPEG_PREFIX ?= $(DEFAULT_PREFIX)

TURBOJPEG_INC = $(TURBOJPEG_PREFIX)/include
TURBOJPEG_LIB = $(TURBOJPEG_PREFIX)/lib

ifneq ($(wildcard $(TURBOJPEG_INC)/turbojpeg.h),)
    CFLAGS  += -DHAVE_LIBJPEG_TURBO -I$(TURBOJPEG_INC)
    LDFLAGS += -L$(TURBOJPEG_LIB) -lturbojpeg
else ifneq ($(wildcard $(TURBOJPEG_INC)/jpeglib.h),)
    CFLAGS  += -I$(TURBOJPEG_INC)
    LDFLAGS += -L$(TURBOJPEG_LIB) -ljpeg
else
    LDFLAGS += -ljpeg
endif

# ---------------------------------------------------------------------------
# x264 (for HLS)
# ---------------------------------------------------------------------------
X264_PREFIX ?= $(DEFAULT_PREFIX)

X264_INC = $(X264_PREFIX)/include
X264_LIB = $(X264_PREFIX)/lib

ifneq ($(wildcard $(X264_INC)/x264.h),)
    CFLAGS  += -I$(X264_INC)
    LDFLAGS += -L$(X264_LIB) -lx264
else
    $(warning x264 headers not found at $(X264_INC)/x264.h)
    $(warning Install: pacman -S mingw-w64-x86_64-x264  [MSYS2])
    $(warning     or:  sudo apt install libx264-dev + cross-compiled libs  [Linux])
    LDFLAGS += -lx264
endif

H264_SRCS    = h264_encoder_x264.c ts_muxer_custom.c
PLATFORM_SRC = platform-windows.c

SRCS = tm_stream_server.c \
       http_server.c \
       jpeg_encoder.c \
       hls_server.c \
       yuv_convert.c \
       $(H264_SRCS) \
       $(PLATFORM_SRC)

OBJS = $(SRCS:.c=.o)

.PHONY: all debug clean installer

all: $(EXE)

# Debug build: symbols, no optimisation, no strip — easy to use with gdb
debug: CFLAGS := $(filter-out -O2,$(CFLAGS)) -g -O0
debug: $(EXE)
	@echo "Debug build complete (not stripped)"

$(EXE): $(OBJS)
	$(CC) $(OBJS) -o $(EXE) $(LDFLAGS)
ifeq ($(MAKECMDGOALS),debug)
	@echo "Skipping strip for debug build"
else
	$(STRIP) $(EXE)
endif

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(EXE)

installer: all
	@which makensis >/dev/null 2>&1 || (echo "ERROR: makensis not found. Install NSIS."; exit 1)
	makensis installer.nsi
