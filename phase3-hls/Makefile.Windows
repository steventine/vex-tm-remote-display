# Cross-compilation settings for Windows x86-64 using MinGW-w64.
# Included by Makefile when CROSS_COMPILE_WINDOWS=1 is set.
#
# Prerequisites (Debian/Ubuntu):
#   sudo apt install gcc-mingw-w64-x86-64
#   # For x264 cross-compiled libs, use MSYS2 on a Windows machine or
#   # obtain pre-built mingw libs and set X264_PREFIX below.
#
# Usage:
#   make CROSS_COMPILE_WINDOWS=1
#   make CROSS_COMPILE_WINDOWS=1 installer

CC      = x86_64-w64-mingw32-gcc
WINDRES = x86_64-w64-mingw32-windres
STRIP   = x86_64-w64-mingw32-strip

CFLAGS  = -Wall -Wextra -O2 -std=c11 -D_WIN32_WINNT=0x0601
LDFLAGS = -static -lws2_32 -lpthread -lwinmm

EXE = tm_stream_server.exe

# ---------------------------------------------------------------------------
# JPEG (for --mode mjpeg): look for libjpeg-turbo in TURBOJPEG_PREFIX
# or fall back to any system-installed cross-libs.
# ---------------------------------------------------------------------------
TURBOJPEG_PREFIX ?= /usr/x86_64-w64-mingw32

TURBOJPEG_INC = $(TURBOJPEG_PREFIX)/include
TURBOJPEG_LIB = $(TURBOJPEG_PREFIX)/lib

ifneq ($(wildcard $(TURBOJPEG_INC)/turbojpeg.h),)
    CFLAGS  += -DHAVE_LIBJPEG_TURBO -I$(TURBOJPEG_INC)
    LDFLAGS += -L$(TURBOJPEG_LIB) -lturbojpeg
else ifneq ($(wildcard $(TURBOJPEG_INC)/jpeglib.h),)
    CFLAGS  += -I$(TURBOJPEG_INC)
    LDFLAGS += -L$(TURBOJPEG_LIB) -ljpeg
else
    LDFLAGS += -ljpeg
endif

# ---------------------------------------------------------------------------
# x264 (for HLS): look for x264 in X264_PREFIX
# Install on MSYS2: pacman -S mingw-w64-x86_64-x264
# Then copy libs/headers to X264_PREFIX or set it to your MSYS2 mingw64 dir.
# ---------------------------------------------------------------------------
X264_PREFIX ?= /usr/x86_64-w64-mingw32

X264_INC = $(X264_PREFIX)/include
X264_LIB = $(X264_PREFIX)/lib

ifneq ($(wildcard $(X264_INC)/x264.h),)
    CFLAGS  += -I$(X264_INC)
    LDFLAGS += -L$(X264_LIB) -lx264
else
    $(warning x264 headers not found at $(X264_INC)/x264.h)
    $(warning Set X264_PREFIX to the directory containing include/x264.h)
    LDFLAGS += -lx264
endif

H264_SRCS    = h264_encoder_x264.c ts_muxer_custom.c
PLATFORM_SRC = platform-windows.c

SRCS = tm_stream_server.c \
       http_server.c \
       jpeg_encoder.c \
       hls_server.c \
       yuv_convert.c \
       $(H264_SRCS) \
       $(PLATFORM_SRC)

OBJS = $(SRCS:.c=.o)

.PHONY: all clean installer

all: $(EXE)

$(EXE): $(OBJS)
	$(CC) $(OBJS) -o $(EXE) $(LDFLAGS)
	$(STRIP) $(EXE)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(EXE)

installer: all
	@which makensis >/dev/null 2>&1 || (echo "ERROR: makensis not found. Install NSIS."; exit 1)
	makensis installer.nsi
